generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  moods     MoodLog[]
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      String
  note      String?
  createdAt DateTime @default(now())
}

model BucketItem {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  addedById   String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}

model Config {
  key   String @id
  value String
}

model TimelineEvent {
  id        String  @id @default(cuid())
  type      String  // "start" | "break" | "reunion" | "milestone"
  date      String  // YYYY-MM-DD
  endDate   String? // YYYY-MM-DD — for breaks only
  title     String
  reason    String?
  createdAt DateTime @default(now())
}

model PissOffLog {
  id        String    @id @default(cuid())
  who       String    // "ashish" | "leena"
  reason    String
  level     Int       // 1–5
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model SpecialOccasion {
  id        String    @id @default(cuid())
  title     String
  date      String    // YYYY-MM-DD
  emoji     String    @default("🎉")
  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}
