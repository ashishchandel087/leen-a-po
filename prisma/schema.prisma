generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        String    @default("user")
  createdAt   DateTime  @default(now())
  // Presence + read-receipts: lastSeenAt updated on heartbeat / activity,
  // lastReadAt is the timestamp of the latest message this user has read.
  lastSeenAt  DateTime?
  lastReadAt  DateTime?
  moods       MoodLog[]
  messages    Message[]
  memories    Memory[]
  reactions   MessageReaction[]
  dailyAnswers DailyAnswer[]
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  mood      String
  note      String?
  createdAt DateTime @default(now())
}

model BucketItem {
  id          String    @id @default(cuid())
  title       String
  completed   Boolean   @default(false)
  addedById   String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}

model Config {
  key   String @id
  value String
}

model TimelineEvent {
  id        String  @id @default(cuid())
  type      String  // "start" | "break" | "reunion" | "milestone"
  date      String  // YYYY-MM-DD
  endDate   String? // YYYY-MM-DD — for breaks only
  title     String
  reason    String?
  createdAt DateTime @default(now())
}

model PissOffLog {
  id        String    @id @default(cuid())
  who       String    // "ashish" | "leena"
  reason    String
  level     Int       // 1–5
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model SpecialOccasion {
  id        String    @id @default(cuid())
  title     String
  date      String    // YYYY-MM-DD
  emoji     String    @default("🎉")
  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id])
  text        String    @default("")
  attachments String[]  @default([])
  // Reply: optional self-reference to a message this one quotes.
  replyToId   String?
  replyTo     Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[] @relation("MessageReply")
  reactions   MessageReaction[]
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  // One emoji per user per message — toggling re-uses this row.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model StickerPack {
  id        String    @id @default(cuid())
  name      String
  emoji     String?
  order     Int       @default(0)
  stickers  Sticker[]
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Sticker {
  id        String      @id @default(cuid())
  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  key       String      // R2 key, e.g. "stickers/<id>.png"
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  @@index([packId])
}

// Question of the day: one row per date, answers hidden from each other
// until both partners have answered ("blind reveal").
model DailyQuestion {
  id        String        @id @default(cuid())
  date      String        @unique // YYYY-MM-DD in the app timezone (Asia/Kolkata)
  prompt    String
  answers   DailyAnswer[]
  createdAt DateTime      @default(now())
}

model DailyAnswer {
  id         String        @id @default(cuid())
  questionId String
  question   DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime      @default(now())

  // One answer per user per question — editable until revealed.
  @@unique([questionId, userId])
}

// Dedupe ledger for scheduled pushes (occasion countdowns, daily question).
// A unique key per logical notification means a re-run cron can't double-send.
model NotificationLog {
  id     String   @id @default(cuid())
  key    String   @unique // e.g. "occasion:<id>:<daysLeft>" or "question:<date>"
  sentAt DateTime @default(now())
}

model Memory {
  id           String    @id @default(cuid())
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  date         String    // YYYY-MM-DD — when the memory happened
  caption      String    @default("")
  location     String?   // free-text place name
  lat          Float?    // optional lat/lng for map view
  lng          Float?
  attachments  String[]  @default([]) // R2 keys: memories/<userId>/<id>.<ext>
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([date])
  @@index([uploadedById])
}
